<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #17a2b8;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            padding: 20px;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        .reminder {
            background-color: #e2f3f5;
            border-left: 4px solid #17a2b8;
            padding: 15px;
            margin: 15px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #17a2b8;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>Pending Leave Requests Requiring Your Approval</h2>
    </div>
    <div class="content">
        <p>Hello {{managerName}},</p>
        
        <div class="reminder">
            <p>You have <strong>{{pendingCount}} pending leave request(s)</strong> that require your attention.</p>
        </div>
        
        {{#if leaves.length}}
        <p>Here are the pending leave requests:</p>
        
        <table>
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                {{#each leaves}}
                <tr>
                    <td>{{this.employeeName}}</td>
                    <td>{{this.leaveType}}</td>
                    <td>{{this.fromDate}}</td>
                    <td>{{this.toDate}}</td>
                    <td>{{this.reason}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{/if}}
        
        <p>Please review these requests at your earliest convenience:</p>
        <p>
            <a href="{{dashboardLink}}" class="button">Review Pending Requests</a>
        </p>
        
        <div class="footer">
            <p>This is an automated reminder. You will receive this email daily until all pending requests are processed.</p>
            <p>&copy; {{currentYear}} Leave Management System</p>
        </div>
    </div>
</body>
</html>
