<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4a6fa5;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            padding: 20px;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        .status-approved {
            color: #28a745;
            font-weight: bold;
        }
        .status-rejected {
            color: #dc3545;
            font-weight: bold;
        }
        .status-pending {
            color: #ffc107;
            font-weight: bold;
        }
        .details {
            margin: 20px 0;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>Your Leave Request Has Been {{#if (eq status "approved")}}Approved{{else if (eq status "rejected")}}Rejected{{else}}Updated{{/if}}</h2>
    </div>
    <div class="content">
        <p>Hello {{employeeName}},</p>
        
        {{#if (eq status "approved")}}
        <p>We're pleased to inform you that your leave request has been <span class="status-approved">approved</span>.</p>
        {{else if (eq status "rejected")}}
        <p>We regret to inform you that your leave request has been <span class="status-rejected">rejected</span>.</p>
        {{else}}
        <p>Your leave request status has been updated to: <span class="status-pending">{{status}}</span>.</p>
        {{/if}}
        
        <div class="details">
            <p><strong>Leave Type:</strong> {{leaveType}}</p>
            <p><strong>From:</strong> {{fromDate}}</p>
            <p><strong>To:</strong> {{toDate}}</p>
            <p><strong>Reason:</strong> {{reason}}</p>
            {{#if approverName}}
            <p><strong>Action by:</strong> {{approverName}} ({{approverRole}})</p>
            {{/if}}
            {{#if comments}}
            <p><strong>Comments:</strong> {{comments}}</p>
            {{/if}}
        </div>
        
        <p>You can view the details of your leave request by logging into the Leave Management System.</p>
        
        <div class="footer">
            <p>This is an automated notification. Please do not reply to this email.</p>
            <p>&copy; {{currentYear}} Leave Management System</p>
        </div>
    </div>
</body>
</html>
