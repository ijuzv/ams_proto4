<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f8f9fa;
        }
        .container {
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            overflow: hidden;
        }
        .header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
        }
        .header h2 {
            margin: 0;
            font-size: 20px;
            color: #111827;
        }
        .content {
            padding: 24px;
        }
        .status-approved {
            color: #16a34a;
            font-weight: 600;
        }
        .status-rejected {
            color: #dc2626;
            font-weight: 600;
        }
        .details {
            margin: 20px 0;
            padding: 16px;
            border: 1px solid #e5e7eb;
            border-radius: 4px;
            background-color: #fafafa;
        }
        .details p {
            margin: 6px 0;
        }
        .actions {
            margin-top: 20px;
        }
        .button-primary {
            display: inline-block;
            padding: 12px 24px;
            background-color: #2563eb;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
        }
        .button-secondary {
            display: inline-block;
            padding: 12px 24px;
            background-color: #ffffff;
            color: #dc2626 !important;
            text-decoration: none;
            border-radius: 4px;
            border: 1px solid #dc2626;
            font-size: 14px;
            font-weight: 600;
            margin-left: 10px;
        }
        .footer {
            margin-top: 24px;
            font-size: 12px;
            color: #6b7280;
            text-align: center;
            border-top: 1px solid #e5e7eb;
            padding: 16px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>
                Leave Request
                {{#if (eq action "approved")}}Approved
                {{else}}Rejected{{/if}}
                by Manager
            </h2>
        </div>

        <div class="content">
            <p>Hello HR Team,</p>

            {{#if message}}
                <p>{{message}}</p>
            {{else}}
                <p>
                    A leave request has been
                    <span class="status-{{action}}">{{action}}</span>
                    by the manager and requires your review.
                </p>
            {{/if}}

            <div class="details">
                <p><strong>Employee:</strong> {{employeeName}}</p>
                <p><strong>Manager:</strong> {{managerName}}</p>
                <p><strong>Leave Type:</strong> {{leaveType}}</p>
                <p><strong>From:</strong> {{fromDate}}</p>
                <p><strong>To:</strong> {{toDate}}</p>
                <p><strong>Reason:</strong> {{reason}}</p>

                {{#if comments}}
                    <p><strong>Manager’s Comments:</strong> {{comments}}</p>
                {{/if}}
            </div>

            <p>Please review and take the appropriate action:</p>

            <div class="actions">
                <a href="{{approveLink}}" class="button-primary">Approve</a>
                <a href="{{rejectLink}}" class="button-secondary">Reject</a>
            </div>
        </div>

        <div class="footer">
            <p>This is an automated notification. Please do not reply.</p>
            <p>&copy; {{currentYear}} Leave Management System</p>
        </div>
    </div>
</body>
</html>
