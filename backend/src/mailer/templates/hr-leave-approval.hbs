<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4a6fa5;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            padding: 20px;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        .status-approved {
            color: #28a745;
            font-weight: bold;
        }
        .status-rejected {
            color: #dc3545;
            font-weight: bold;
        }
        .details {
            margin: 20px 0;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }
        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #4a6fa5;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>Leave Request {{#if (eq action "approved")}}Approved{{else}}Rejected{{/if}} by Manager</h2>
    </div>
    <div class="content">
        <p>Hello HR Team,</p>
        <p>A leave request has been <span class="status-{{action}}">{{action}}</span> by the manager and requires your attention.</p>
        
        <div class="details">
            <p><strong>Employee:</strong> {{employeeName}}</p>
            <p><strong>Manager:</strong> {{managerName}}</p>
            <p><strong>Leave Type:</strong> {{leaveType}}</p>
            <p><strong>From:</strong> {{fromDate}}</p>
            <p><strong>To:</strong> {{toDate}}</p>
            <p><strong>Reason:</strong> {{reason}}</p>
            {{#if comments}}
            <p><strong>Manager's Comments:</strong> {{comments}}</p>
            {{/if}}
        </div>
        
        <p>Please review and take appropriate action:</p>
        <p>
            <a href="{{approveLink}}" class="button">Approve</a>
            <a href="{{rejectLink}}" class="button" style="background-color: #dc3545; margin-left: 10px;">Reject</a>
        </p>
        
        <div class="footer">
            <p>This is an automated notification. Please do not reply to this email.</p>
            <p>&copy; {{currentYear}} Leave Management System</p>
        </div>
    </div>
</body>
</html>
