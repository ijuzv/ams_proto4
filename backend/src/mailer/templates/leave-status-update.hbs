<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4a6fa5;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            padding: 20px;
            border: 1px solid #ddd;
            border-top: none;
            border-radius: 0 0 5px 5px;
        }
        .status-approved {
            color: #28a745;
            font-weight: bold;
        }
        .status-rejected {
            color: #dc3545;
            font-weight: bold;
        }
        .details {
            margin: 20px 0;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>Leave Request Update</h2>
    </div>
    <div class="content">
        <p>Hello <strong>{{userName}}</strong>,</p>
        
        {{#if (or (eq status "approved") (eq status "MANAGER_APPROVED") (eq status "HR_APPROVED"))}}
        <p>Your leave request has been <span class="status-approved">approved</span>.</p>
        {{else}}
        <p>Your leave request has been <span class="status-rejected">rejected</span>.</p>
        {{/if}}
        
        <div class="details">
            <p><strong>Leave Type:</strong> {{leaveType}}</p>
            <p><strong>From:</strong> {{fromDate}}</p>
            <p><strong>To:</strong> {{toDate}}</p>
            <p><strong>Status:</strong> {{status}}</p>
        </div>
        
        <p>If you have any questions, please contact your HR department.</p>
        
        <div class="footer">
            <p>This is an automated message. Please do not reply to this email.</p>
            <p>&copy; {{currentYear}} Leave Management System. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
