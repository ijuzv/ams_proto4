// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MANAGER
  CEO
}

enum UserGender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  WFO
  WFH
  CL
  SL
  EL
  COMP_OFF
  AB
  OL
  ML
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  MANAGER_REJECTED
  HR_APPROVED
  HR_REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  COMP_OFF
  LOP
  OPTIONAL
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  gender        UserGender?
  role          UserRole       @default(USER)
  managerId     Int?
  manager       User?          @relation("UserManager", fields: [managerId], references: [id])
  subordinates  User[]         @relation("UserManager")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  active        Boolean        @default(true)
  designation   String?
  shift         String?
  team          String?
  avatar        String?
  joiningDate   DateTime?      @db.Date
  leaveBalances LeaveBalance[]
}

model Attendance {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId], name: "attendance_userId_idx")
  @@index([date], name: "attendance_date_idx")
  @@index([userId, date], name: "attendance_userId_date_idx")
}

model LeaveRequest {
  id         Int         @id @default(autoincrement())
  userId     Int
  user       User        @relation(fields: [userId], references: [id])
  type       LeaveType
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy Int?
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status], name: "leave_request_status_idx")
  @@index([userId], name: "leave_request_userId_idx")
}

model LeaveBalance {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  clBalance Float    @default(0) // Casual Leave
  slBalance Float    @default(0) // Sick Leave
  elBalance Float    @default(0) // Earned Leave
  olBalance Float    @default(0) // Optional Leave
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  name        String
  description String?
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Indexes are now defined within their respective models
